{
  "manifest_version": 3,
  "name": "AI Answer Helper",
  "version": "1.0",
  "description": "Ask questions and get answers from DeepSeek AI.",

  "permissions": ["storage"],

  "host_permissions": [
    "https://api.deepseek.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  }
}
